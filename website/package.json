{
  "name": "r2k16-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Docusaurus documentation site for the R2K16 codebase (modded fork of the 2016 Roblox engine source)",
  "scripts": {
    "generate-docs": "python3 ../scripts/generate_docs.py",
    "prebuild": "python3 ../scripts/generate_docs.py",
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 0.0.0.0 --no-open",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 0.0.0.0",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/theme-mermaid": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "joi": "17.13.9",
    "katex": "0.19.1",
    "launch-editor": "2.14.2",
    "mermaid": "12.2.0",
    "minimatch": "11.0.1",
    "postcss-selector-parser": "7.1.7",
    "qs": "6.17.1",
    "serialize-javascript": "7.1.4",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "tinypool": "2.2.0"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome versions", "last 3 firefox versions", "last 5 safari versions"]
  }
}
